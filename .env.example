# n8n Environment Configuration
# deploy.sh generates .env for you. To write it by hand instead:
#   cp .env.example .env && chmod 600 .env

# ── Version ──
# "stable" tracks the latest stable release (update.sh pulls it).
# Pin a specific release (e.g. 2.42.5) for reproducible deploys.
N8N_VERSION=stable

# ── Access ──
# ACCESS_MODE=ip      → plain HTTP on the server's public IP (no domain needed)
# ACCESS_MODE=domain  → domain behind upstream SSL termination (LB / Cloudflare)
ACCESS_MODE=ip
N8N_HOST=203.0.113.10
N8N_PROTOCOL=http
WEBHOOK_URL=http://203.0.113.10/
# Must be false when serving over plain HTTP, otherwise login fails
N8N_SECURE_COOKIE=false

# ── Encryption ──
# Generate with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=your-encryption-key-here

# ── Database ──
POSTGRES_USER=n8n
# Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=your-postgres-password-here
POSTGRES_DB=n8n

# ── n8n Settings ──
GENERIC_TIMEZONE=UTC
N8N_LOG_LEVEL=info
N8N_METRICS=false
N8N_DIAGNOSTICS_ENABLED=false
N8N_PERSONALIZATION_ENABLED=false

# ── Execution Settings ──
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=168
